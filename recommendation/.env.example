# AvalAI key for its OpenAI-compatible API. Do not commit the real .env file.
OPENAI_API_KEY=replace_with_your_avalai_key
DJANGO_SECRET_KEY=replace_with_a_long_random_secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Local development uses SQLite when POSTGRES_DB is absent.
# POSTGRES_DB=recommender
# POSTGRES_USER=recommender
# POSTGRES_PASSWORD=replace_me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
